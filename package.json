{
    "name": "miaomiao-monitor",
    "private": true,
    "packageManager": "pnpm@9.12.2",
    "scripts": {
        "build": "turbo build --filter=!{./demos/*}",
        "build:watch": "turbo build:watch",
        "db:migrate:clickhouse": "clickhouse-migrations migrate --host \"${CLICKHOUSE_URL:?CLICKHOUSE_URL is required}\" --user \"${CLICKHOUSE_USERNAME:?CLICKHOUSE_USERNAME is required}\" --password \"${CLICKHOUSE_PASSWORD:?CLICKHOUSE_PASSWORD is required}\" --db \"${CLICKHOUSE_DATABASE:?CLICKHOUSE_DATABASE is required}\" --migrations-home sql/migrations",
        "clean": "rm -rf .turbo packages/*/dist packages/*/node_modules",
        "commit": "git-cz",
        "lint": "eslint --config eslint.config.mjs .",
        "lint:staged": "lint-staged",
        "prepare": "husky",
        "spellcheck": "cspell --no-progress 'packages/**/*.ts' 'packages/**/*.md' 'docs/**/*.md' '*.md' '*.json'",
        "dev:server:dsn": "pnpm --filter @miaomiao/monitor-dsn-server start:dev",
        "dev:server:monitor": "pnpm --filter @miaomiao/monitor-server start:dev",
        "dev:client:monitor": "pnpm --filter @miaomiao/monitor-client dev",
        "docker:start": "docker compose -p miaomiao-monitor --env-file .env.development -f docker/docker-compose.yml up -d",
        "docker:stop": "docker compose -p miaomiao-monitor --env-file .env.development -f docker/docker-compose.yml down",
        "docker:deploy": "docker compose -p miaomiao-monitor --env-file .env.production -f docker/docker-compose.deploy.yml up -d",
        "docker:deploy:stop": "docker compose -p miaomiao-monitor --env-file .env.production -f docker/docker-compose.deploy.yml down"
    },
    "config": {
        "commitizen": {
            "path": "cz-git"
        }
    },
    "devDependencies": {
        "@commitlint/cli": "19.5.0",
        "@commitlint/config-conventional": "19.5.0",
        "@eslint/js": "9.12.0",
        "@types/node": "22.7.4",
        "commitizen": "4.3.1",
        "cspell": "8.14.4",
        "cz-git": "1.10.1",
        "eslint": "9.12.0",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-prettier": "5.2.1",
        "eslint-plugin-simple-import-sort": "12.1.1",
        "eslint-plugin-react-hooks": "7.1.1",
        "husky": "9.1.6",
        "lint-staged": "15.2.10",
        "prettier": "3.3.3",
        "turbo": "2.1.3",
        "typescript": "5.5.3",
        "clickhouse-migrations": "1.5.0",
        "typescript-eslint": "8.8.1",
        "tsup": "8.5.1",
        "rimraf": "6.1.3",
        "globals": "17.12.0"
    }
}
