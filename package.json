{
    "name": "miaomiao-monitor",
    "private": true,
    "packageManager": "pnpm@9.11.0",
    "scripts": {
        "build": "turbo build",
        "build:watch": "turbo build:watch",
        "clean": "rm -rf .turbo packages/*/dist packages/*/build packages/*/node_modules",
        "commit": "git-cz",
        "lint": "eslint .",
        "lint:staged": "lint-staged",
        "prepare": "husky",
        "spellcheck": "cspell --no-progress 'packages/**/*.ts' 'packages/**/*.md' 'docs/**/*.md' '*.md' '*.json'"
    },
    "config": {
        "commitizen": {
            "path": "cz-git"
        }
    },
    "devDependencies": {
        "@commitlint/cli": "19.5.0",
        "@commitlint/config-conventional": "19.5.0",
        "@eslint/js": "9.12.0",
        "@types/node": "22.7.4",
        "commitizen": "4.3.1",
        "cspell": "8.14.4",
        "cz-git": "1.10.1",
        "eslint": "9.12.0",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-prettier": "5.2.1",
        "eslint-plugin-simple-import-sort": "12.1.1",
        "husky": "9.1.6",
        "lint-staged": "15.2.10",
        "prettier": "3.3.3",
        "turbo": "2.1.3",
        "typescript": "5.5.3",
        "typescript-eslint": "8.8.1"
    }
}
